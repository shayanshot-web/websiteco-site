# ---- سایت استاتیک Next.js روی سی‌پنل (Apache) ----
DirectoryIndex index.html index.php
Options -Indexes

<IfModule mod_rewrite.c>
RewriteEngine On

# اعتبارسنجی SSL (AutoSSL) به این مسیر روی http نیاز دارد؛ ریدایرکت نشود
RewriteRule ^\.well-known/ - [L]

# ریدایرکت به https (بعد از صدور SSL فعال می‌شود)
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www -> بدون www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---- پنل مدیریت: صفحات و محتوای پویا از طریق dynamic.php (اگر محتوایی نباشد همان صفحه استاتیک نمایش داده می‌شود) ----
<IfModule mod_rewrite.c>
RewriteRule ^sitemap-cms\.xml$ /dynamic.php?sitemap=1 [L]
RewriteRule ^search-cms\.json$ /dynamic.php?searchindex=1 [L]
# صفحهٔ اصلی هر زبان (نوار «تجربه‌ها» از پنل؛ بدون داده در پنل همان صفحهٔ استاتیک نمایش داده می‌شود)
RewriteRule ^(?:(en|ru)/)?$ /dynamic.php?home=1&hl=$1 [L,QSA]
RewriteRule ^((?:en/|ru/)?(?:about|accommodations|experiences|gallery|blog|events|handicraft-shop|about-us|stay|things-to-do|photo-gallery|travel-blog|events-calendar|craft-shop|o-nas|prozhivanie|vpechatleniya|galereya|blog-helile|sobytiya|remesla)(?:/[^/.]+)?)/?$ /dynamic.php?p=$1 [L,QSA]
</IfModule>

ErrorDocument 404 /404.html

# فشرده‌سازی
<IfModule mod_deflate.c>
AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml text/plain application/xml
</IfModule>

# کش فایل‌های ثابت (نام فایل‌های _next/static شامل هش است)
<IfModule mod_expires.c>
ExpiresActive On
ExpiresByType text/css "access plus 1 year"
ExpiresByType application/javascript "access plus 1 year"
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/svg+xml "access plus 1 month"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# ---- هدرهای امنیتی ----
<IfModule mod_headers.c>
Header always set X-Content-Type-Options "nosniff"
Header always set Referrer-Policy "strict-origin-when-cross-origin"
Header always set X-Frame-Options "SAMEORIGIN"
# فقط HTTPS (۱۸۰ روز؛ بدون includeSubDomains و preload تا اگر جایی SSL نداشتید مشکل نشود)
Header always set Strict-Transport-Security "max-age=15552000"
Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
# پایهٔ CSP: جلوگیری از قرارگرفتن سایت در iframe دیگران، تغییر base، پلاگین‌ها و ارسال فرم به بیرون (بدون محدودکردن اسکریپت/تصویر؛ آن را بدون تست روی هاست نمی‌شود سخت‌تر کرد)
Header always set Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; object-src 'none'; form-action 'self'"
Header always unset X-Powered-By
</IfModule>

# ---- فایل‌هایی که نباید از وب باز شوند ----
# فایل‌های نقطه‌دار (مثل .ftp-deploy-sync-state.json؛ پوشهٔ .well-known جداست و مشمول نمی‌شود)
<FilesMatch "^\.">
Require all denied
</FilesMatch>
# دیتابیس، لاگ، بک‌آپ، تنظیمات و فایل‌های موقت ویرایشگر
<FilesMatch "\.(sqlite|sqlite3|db|sql|bak|log|env|ini|lock|swp|orig|old)$">
Require all denied
</FilesMatch>
# از فایل‌های PHP فقط نقطه‌های ورود مجاز است (admin/xp.php، admin/views.php و … مستقیم باز نمی‌شوند؛ cms-core هم جداگانه بسته است)
<FilesMatch "^(?!(index|dynamic|contact|comments|install|reset-admin)\.php$).*\.php$">
Require all denied
</FilesMatch>
